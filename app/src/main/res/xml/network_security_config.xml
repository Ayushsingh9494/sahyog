<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS everywhere, except the phone's own loopback address: during development the
    laptop's API server is reached through `adb reverse tcp:8080 tcp:8080` as 127.0.0.1:8080.
    Traffic to the loopback never leaves the device. Production uses https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
